# --- environment ---
.env
.env.local
*.local

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
.coverage.*

# --- node ---
node_modules/
dist/
.vite/
.turbo/

# --- editors ---
.idea/
.vscode/
*.swp
*.swo

# --- os ---
.DS_Store
Thumbs.db

# --- docker / data ---
volumes/
*.pid
*.log
clickhouse-data/
postgres-data/
redis-data/

# --- ml artefacts ---
# WHY ml/models/ wholesale: trained models (.pkl) and per-version
# metadata (.json) live in subdirs like ml/models/v20260509T123128/
# and ml/models/active/. The previous rules only matched direct
# children, leaking model blobs into git. Anyone can regenerate them
# with `make train` (deterministic on the synthetic dataset).
ml/models/
ml/datasets/raw/
ml/datasets/processed/
# WHY ml/drift_reports/: written by drift_worker.py on every run;
# JSON files keyed by UTC timestamp. Useful locally for triage but
# never reviewed in PR — committing them would balloon the repo.
ml/drift_reports/

# --- build / generated ---
build/
*.egg
.pdm-python

# --- vendored at build time, not committed ---
# WHY: ml-service/Dockerfile expects a copy of waf_ml/ next to itself
# (one source of truth for featurizer). dev.ps1 / Makefile re-syncs it
# from ml/src/waf_ml/ before each build. Committing the copy would
# create two-source drift the moment someone edits one but not the other.
ml-service/waf_ml/

# --- course-project deliverables (kept local, not published) ---
# WHY: the .docx / .pdf plan is the academic deliverable for the
# university — it carries personal info (author, group, supervisor)
# and uses the IEML brand. The public GitHub repo is the engineering
# portfolio; the academic artefact lives separately. Anyone who needs
# both can check out the private course-project repo.
План_курсового_проекта_WAF.docx
План_курсового_проекта_WAF.pdf

# scratch error captures (never committed)
ml/err.txt
*.err.txt

# --- e2e artefacts (Playwright) ---
# WHY: `npx playwright test` writes html report + trace zips to these
# folders. They're useful locally on a failed run, but absolutely
# nobody wants megabytes of test traces in the repo. CI uploads them
# as job artefacts in `dump logs on failure`, not via git.
e2e/playwright-report/
e2e/test-results/
e2e/playwright/.cache/

# --- bench artefacts ---
# WHY: bench/reports/ holds sample + generated. The committed sample
# (bench/reports/SAMPLE.md) is intentional; everything else is a
# `<UTC>.json` snapshot of one run.
bench/reports/*
!bench/reports/SAMPLE.md

# --- fly.io local state ---
# WHY: `flyctl deploy` keeps a per-app cache in `.fly/`; secrets get
# written to `.fly/secrets/`. Both are machine-local and would be a
# secret leak if pushed.
.fly/
fly.toml.local

# --- frontend coverage / typegen scratch ---
# WHY: `vitest run --coverage` emits `coverage/`; OpenAPI typegen
# emits a temp dir during regen. Neither is reproducible across
# machines and both balloon diff noise.
frontend/coverage/
frontend/.openapi-tmp/

# --- alembic local notes ---
# WHY: scratch migration drafts before they get a real revision id.
backend/alembic/versions/.draft/
