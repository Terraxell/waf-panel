# Copy to .env and adjust. Never commit .env.

# --- ports exposed on the host ---
PROXY_PORT=8080
BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
REDIS_PORT=6379
ML_SERVICE_PORT=8001

# --- postgres ---
POSTGRES_USER=waf
POSTGRES_PASSWORD=waf_dev_only
POSTGRES_DB=waf_panel

# --- clickhouse ---
CH_USER=waf
CH_PASSWORD=waf_dev_only
CH_DB=waf_logs

# --- backend ---
# WHY: HS256 is enough for a course project; rotate to RS256 + KMS if going prod.
JWT_SECRET=change_me_in_a_real_deployment
JWT_TTL_MINUTES=60

# --- modsecurity ---
# WHY: SecRuleEngine accepts: On | Off | DetectionOnly
#      "On"            — rules run AND block on score breach (production-style).
#      "DetectionOnly" — rules run but never block; useful for tuning a new ruleset.
#      "Off"           — disable WAF entirely (debug only).
MODSEC_RULE_ENGINE=On
PARANOIA=1
ANOMALY_INBOUND=5
ANOMALY_OUTBOUND=4

# --- proxy flavour  ---
# WHY: default flavour is the upstream CRS image (no Lua, fastest build).
#      Switch to Dockerfile.openresty to opt into Lua subrequest scoring;
#      first build takes ~20 minutes (compiles libmodsecurity from source).
PROXY_FLAVOR_DOCKERFILE=Dockerfile

# --- ML block-mode threshold  ---
# WHY: Lua reads $ml_block_threshold; default 1.0 = annotate-only (never
#      blocks). After `make calibrate` (offline, against real labels)
#      lower this to e.g. 0.93 to enable block-mode at FPR ≤ 1%. Three
#      independent kill-switches (ADR-0011): UI slider, this env, and
#      the proxy flavour fallback.
ML_BLOCK_THRESHOLD=1.0

# --- AWS WAF integration  ---
# WHY: optional outbound IPSet sync for cloud-fronted assets. Default off.
WAF_AWS_ENABLED=false
WAF_AWS_REGION=us-east-1
WAF_AWS_IPSET_ID=
WAF_AWS_IPSET_NAME=
WAF_AWS_SCOPE=REGIONAL

# --- ml-service  ---
# WHY: backend → ml-service is fail-open. Tighten the timeout if you
#      run the service on a fast host; widen it for cold-start machines.
ML_SERVICE_URL=http://ml-service:8001
ML_SERVICE_TIMEOUT_MS=20
ML_MODEL_ALGO=xgboost
ML_FALLBACK_ALGO=lr
ML_REDIS_TTL_SEC=30
# Set to "true" once ml_models registry is populated (`make train-register`).
ML_USE_REGISTRY=false
