# WHY: Windows hosts default to CRLF, but anything mounted into a Linux
#      container (nginx config, shell scripts, init.sql, vector.toml) needs
#      LF or the runtime trips on `\r` in shebangs and unquoted strings.
#      We mark the at-risk file types explicitly.

* text=auto eol=lf

*.sh         text eol=lf
*.bash       text eol=lf
*.conf       text eol=lf
*.template   text eol=lf
*.toml       text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
Makefile     text eol=lf
Dockerfile   text eol=lf
*.ini        text eol=lf
*.sql        text eol=lf
*.py         text eol=lf
*.ts         text eol=lf
*.tsx        text eol=lf
*.css        text eol=lf
*.html       text eol=lf
*.md         text eol=lf
*.json       text eol=lf

# Binary — leave untouched.
*.docx       binary
*.pdf        binary
*.png        binary
*.jpg        binary
